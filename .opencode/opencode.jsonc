{
  // CONVENTION EXCEPTION: ruff is installed with `uv tool install` because
  // upstream publishes no standalone checksum manifest for the binary.
  // https://docs.astral.sh/uv/guides/tools/
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "scribe",
  "instructions": ["./instructions/**", "./templates/**"],
  "plugin": ["./plugins/opencode-rbash/src/index.ts"],
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "formatter": {
    "prettier": {
      "command": ["npx", "prettier", "--write", "$FILE"]
    },
    "shfmt": {},
    "ruff": {},
    "gofmt": {},
    "rustfmt": {},
    "clang-format": {},
    "air": {}
  },
  "permission": {
    "edit": {
      "**/.opencode/plans/**": "deny",
      "**/.opencode/plan.md": "deny",
      "**/.opencode/Plan.md": "deny",
      "**/.opencode/PLAN.md": "deny"
    },
    "external_directory": {
      "*": "deny",
      "/tmp/opencode/**": "allow",
      "{env:HOME}/src/**": "allow",
      "{env:HOME}/plans/**": "allow",
      "{env:PLAN_STORAGE_PATH}/**": "allow",
      "{env:HOME}/.config/dotfiles/repos/wywy-dotfiles-dev/**": "allow"
    },
    "read": {
      "**/.env": "allow",
      "**/.env.*": "allow"
    },
    "bash": {
      "sudo": "deny",
      "sops": "deny"
    }
  }
}
